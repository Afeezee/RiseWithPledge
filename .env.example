## --- Core session / admin bootstrap ---
SESSION_SECRET=replace-with-a-long-random-string
SEED_ADMIN_USERS=olagunjuafeez@gmail.com,info.risewithpledgefoundation@gmail.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-password

## Public site URL (used to build unsubscribe links in email bodies).
SITE_URL=https://risewithpledge.org
SITE_NAME=Rise With Pledge Foundation

## --- Neon Postgres (durable store for subscribers, campaigns, content, admins) ---
## Get from https://console.neon.tech → Project → Connection Details (pooled).
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

## --- Vercel Blob (durable file uploads) ---
## In Vercel: Project → Storage → Blob → Connect. Vercel injects this env var
## automatically after you connect; in local .env, paste the "Read/Write Token".
BLOB_READ_WRITE_TOKEN=

## --- Resend (primary email provider) ---
## Get from https://resend.com → API Keys.
RESEND_API_KEY=
## Must be an address on a verified domain in Resend → Domains.
RESEND_FROM_EMAIL=hello@risewithpledge.org
RESEND_FROM_NAME=Rise With Pledge Foundation
RESEND_REPLY_TO=hello@risewithpledge.org
## Shared secret appended to the Resend webhook URL as ?secret=...
RESEND_WEBHOOK_SECRET=replace-with-a-long-random-string

## --- Email provider selector ---
## 'resend' (default) uses Resend for everything.
## 'brevo' falls back to the Brevo transactional endpoint.
EMAIL_PROVIDER=resend

## --- Vercel Cron (birthday automation) ---
## Vercel auto-sets this when a cron is configured; set it yourself locally
## if you want to hit /api/cron/birthdays with curl.
CRON_SECRET=replace-with-a-long-random-string
## Where the daily birthday digest goes (admin inbox).
ADMIN_DIGEST_EMAIL=info.risewithpledgefoundation@gmail.com

## --- Brevo (kept wired as a fallback) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info.risewithpledgefoundation@gmail.com
BREVO_SENDER_NAME=Rise With Pledge Foundation
BREVO_REPLY_TO=info.risewithpledgefoundation@gmail.com
BREVO_LIST_NEWSLETTER=
BREVO_LIST_VOLUNTEER=
BREVO_LIST_MEMBERSHIP=
BREVO_LIST_PLEDGE=
BREVO_LIST_PARTNER=
BREVO_LIST_CONTACT=
BREVO_WEBHOOK_SECRET=replace-with-a-long-random-string
