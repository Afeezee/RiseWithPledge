## --- Core session / admin bootstrap ---
SESSION_SECRET=replace-with-a-long-random-string
SEED_ADMIN_USERS=olagunjuafeez@gmail.com,info.risewithpledgefoundation@gmail.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-password

## --- Neon Postgres (durable subscribers + campaigns store) ---
## Get from https://console.neon.tech → Project → Connection Details.
## Use the "pooled connection" string.
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

## --- Brevo (contact sync + campaign delivery) ---
## Get from https://app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=
## Must be a Verified Sender in Brevo, otherwise campaign sends fail.
BREVO_SENDER_EMAIL=info.risewithpledgefoundation@gmail.com
BREVO_SENDER_NAME=Rise With Pledge Foundation
BREVO_REPLY_TO=info.risewithpledgefoundation@gmail.com

## Numeric list ids from Brevo → Contacts → Lists. One per source.
## Create the six lists in Brevo first, then paste their ids here.
BREVO_LIST_NEWSLETTER=
BREVO_LIST_VOLUNTEER=
BREVO_LIST_MEMBERSHIP=
BREVO_LIST_PLEDGE=
BREVO_LIST_PARTNER=
BREVO_LIST_CONTACT=

## Shared secret appended to the Brevo webhook URL as ?secret=...
## Any long random string. Keep in sync with the URL configured in Brevo.
BREVO_WEBHOOK_SECRET=replace-with-a-long-random-string
